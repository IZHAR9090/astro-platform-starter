---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to My Portfolio">
  <section class="flex flex-col items-center gap-8 md:flex-row md:items-start md:gap-12">
    
    <!-- Left side: Profile picture -->
    <div class="flex-shrink-0">
      <img 
        src="/images/pic.heif" 
        alt="Izhar Ahmad" 
        class="w-40 h-40 rounded-full object-cover border-4 border-white shadow-lg"
      />
    </div>

    <!-- Right side: Bio -->
    <div class="max-w-xl text-center md:text-left">
      <h1 class="text-3xl font-bold mb-4">Hi, I’m Izhar Ahmad 👋</h1>
      <p class="text-lg leading-relaxed opacity-90">
        I’m a game developer and software engineer passionate about building 
        engaging experiences with Unity, multiplayer systems, and modern web tools.  
        Currently working on <strong>Memory Maze: Time-Bound Puzzle</strong> 
        and exploring creative ideas for mobile and web projects.
      </p>

      <!-- Optional button links -->
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="/projects" class="px-5 py-2 bg-white text-black rounded-full hover:bg-gray-200">
          View My Projects
        </a>
        <a href="/contact" class="px-5 py-2 border border-white rounded-full hover:bg-white hover:text-black">
          Contact Me
        </a>
      </div>
    </div>
  </section>
</Layout>

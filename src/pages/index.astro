---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to My Portfolio">
 <section class="w-full bg-gradient-to-b from-[#0f172a] to-[#1e293b] py-12">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Profile aur Bio -->
    <div class="flex flex-col items-center gap-10 md:flex-row md:items-start md:gap-16">
      <!-- Profile Image -->
      <div class="flex-shrink-0">
        <img 
          src="/images/pic.png" 
          alt="Izhar Ahmad" 
          class="w-44 h-44 rounded-full object-cover border-4 border-white shadow-lg"
        />
      </div>

      <!-- Bio -->
      <div class="max-w-xl text-center md:text-left">
        <h1 class="text-4xl font-bold mb-4">Hi, I’m Izhar Ahmad 👋</h1>
        <p class="text-lg leading-relaxed opacity-90">
          I’m a game developer and software engineer passionate about building 
          engaging experiences with Unity, multiplayer systems, and modern web tools.  
          Currently working on <strong>Memory Maze: Time-Bound Puzzle</strong> 
          and exploring creative ideas for mobile and web projects.
        </p>
        <div class="mt-6">
          <a href="/resume.pdf" download
             class="px-6 py-2 bg-white text-black rounded-full hover:bg-gray-200 no-underline">
            Download My Resume
          </a>
        </div>
      </div>
    </div>

    <!-- Projects Section -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-center mb-10">My Latest Projects</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <div class="bg-slate-900 p-6 rounded-2xl w-[280px] mx-auto">
          <img src="/images/project1.png" alt="Texas Hold'em 3D" class="w-full h-40 object-cover rounded-lg mb-4">
          <h3 class="text-lg font-semibold">Texas Hold'em 3D – Multiplayer Poker Game</h3>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl w-[280px] mx-auto">
          <img src="/images/project2.png" alt="POS System" class="w-full h-40 object-cover rounded-lg mb-4">
          <h3 class="text-lg font-semibold">Point of Sale System</h3>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl w-[280px] mx-auto">
          <img src="/images/project3.png" alt="Speedway Multiplayer" class="w-full h-40 object-cover rounded-lg mb-4">
          <h3 class="text-lg font-semibold">Speedway Multiplayer</h3>
        </div>
      </div>

      <div class="flex justify-center mt-10">
        <a href="/projects" 
           class="px-6 py-2 border border-white rounded-full hover:bg-white hover:text-black no-underline">
          Explore More
        </a>
      </div>
    </div>
  </div>
</section>







</Layout>

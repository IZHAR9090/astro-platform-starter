---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to My Portfolio">
<section class="relative flex flex-col-reverse md:flex-row items-center justify-center text-center md:text-left py-16 px-6 md:px-16">
  
  <!-- Left: Text content -->
  <div class="md:w-1/2 space-y-6">
    <h1 class="text-4xl md:text-6xl font-extrabold text-white">
      Hi, I’m <span class="text-cyan-400">Izhar Ahmad</span> 👋
    </h1>

    <!-- Typewriter effect -->
    <p class="text-lg md:text-xl font-mono text-gray-300 max-w-2xl leading-relaxed text-justify"">
  Unity Game Developer with 3 years of experience creating hyper-casual, multiplayer, and simulation games. 
  I specialize in building engaging gameplay systems, optimizing performance, and integrating monetization 
  solutions like AdMob and in-app purchases. Passionate about game design and innovation, I love turning 
  creative ideas into interactive experiences.
</p>

    <!-- Call to Action Button -->
    <div class="pt-6">
  <a href="/IZHAR AHMAD Resume.pdf" 
     download 
     class="px-6 py-3 text-lg font-semibold bg-pink-500 text-white rounded-full hover:bg-pink-400 transition no-underline">
    Download My Resume
  </a>
</div>
  </div>

  <!-- Right: Profile Picture -->
  <div class="md:w-1/2 flex justify-center mb-8 md:mb-0">
    <img 
      src="/images/pic.png" 
      alt="Izhar Ahmad" 
      class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover border-4 border-cyan-400 shadow-lg"
    />
  </div>
</section>


<!-- Typewriter Script -->
<script>
  const text = "Unity Game Developer with 3 years of experience creating hyper-casual, multiplayer, and simulation games. I specialize in building engaging gameplay systems, optimizing performance, and integrating monetization solutions like AdMob and in-app purchases. Passionate about game design and innovation, I love turning creative ideas into interactive experiences.";
  
  let i = 0;
  const speed = 40; // typing speed (ms)

  function type() {
    if (i < text.length) {
      document.getElementById("typewriter").textContent += text.charAt(i);
      i++;
      setTimeout(type, speed);
    }
  }

  type();
</script>



<section class="mt-16" w-full>
<h2 class="text-3xl font-bold mb-10 text-center text-white">
  My Latest Projects
</h2>

  <!-- Grid of projects -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10 max-w-7xl mx-auto">
    
    <!-- Project 1 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/poker.png" alt="Texas Hold'em 3D" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Texas Hold'em 3D – Multiplayer Poker Game</h3>
    </div>

    <!-- Project 2 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/pos.png" alt="Point of Sale System" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Point of Sale System</h3>
    </div>

    <!-- Project 3 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/speedway.png" alt="Speedway Multiplayer" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Speedway Multiplayer</h3>
    </div>

    <!-- Project 4 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">

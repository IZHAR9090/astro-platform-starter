---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to My Portfolio">
  <section class="mt-12 flex flex-col items-center gap-8 md:flex-row md:items-start md:gap-32">
    
    <!-- Left side: Profile picture -->
    <div class="flex-shrink-0">
      <img 
        src="/images/pic.png" 
        alt="Izhar Ahmad" 
        class="w-48 h-48 rounded-full object-cover border-4 border-white shadow-lg"
      />
    </div>

    <!-- Right side: Bio -->
    <div class="max-w-xl text-center md:text-left">
      <h1 class="text-3xl font-bold mb-4">Hi, I’m Izhar Ahmad 👋</h1>
      <p class="text-lg leading-relaxed opacity-90">
        I’m a game developer and software engineer passionate about building 
        engaging experiences with Unity, multiplayer systems, and modern web tools.  
        Currently working on <strong>Memory Maze: Time-Bound Puzzle</strong> 
        and exploring creative ideas for mobile and web projects.
      </p>

      <!-- Resume Button -->
      <div class="mt-6">
        <a 
          href="/IZHAR AHMAD Resume.pdf" 
          download
          class="no-underline px-6 py-3 bg-white text-black rounded-full shadow-md hover:bg-gray-200 hover:scale-105 transition-transform duration-200"
        >
          Download My Resume
        </a>
      </div>
    </div>
  </section>
</Layout>

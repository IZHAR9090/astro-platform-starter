      <h3 class="text-lg font-semibold text-center">Grand Gangster Vegas City Sim</h3>
    </div>

    <!-- Project 5 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">

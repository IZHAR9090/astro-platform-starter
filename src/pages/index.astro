---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to My Portfolio">
  <section class="mt-12 flex flex-col items-center gap-8 md:flex-row md:items-start md:gap-32 w-full">
    
    <!-- Left side: Profile picture -->
    <div class="flex-shrink-0">
      <img 
        src="/images/pic.png" 
        alt="Izhar Ahmad" 
        class="w-48 h-48 rounded-full object-cover border-4 border-white shadow-lg"
      />
    </div>

    <!-- Right side: Bio -->
    <div class="max-w-xl text-center md:text-left">
      <h1 class="text-3xl font-bold mb-4">Hi, I’m Izhar Ahmad 👋</h1>
      <p class="text-lg leading-relaxed opacity-90">
        I’m a game developer and software engineer passionate about building 
        engaging experiences with Unity, multiplayer systems, and modern web tools.  
        Currently working on <strong>Memory Maze: Time-Bound Puzzle</strong> 
        and exploring creative ideas for mobile and web projects.
      </p>

      <!-- Resume Button -->
      <div class="mt-6">
        <a 
          href="/IZHAR AHMAD Resume.pdf" 
          download
          class="no-underline px-6 py-3 bg-white text-black rounded-full shadow-md hover:bg-gray-200 hover:scale-105 transition-transform duration-200"
        >
          Download My Resume
        </a>
      </div>
    </div>
  </section>


<section class="mt-16">
  <h2 class="text-3xl font-bold text-center mb-10">My Latest Projects</h2>

  <!-- Grid of projects -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10 max-w-7xl mx-auto">
    
    <!-- Project 1 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/poker.png" alt="Texas Hold'em 3D" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Texas Hold'em 3D – Multiplayer Poker Game</h3>
    </div>

    <!-- Project 2 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/pos.png" alt="Point of Sale System" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Point of Sale System</h3>
    </div>

    <!-- Project 3 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/speedway.png" alt="Speedway Multiplayer" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Speedway Multiplayer</h3>
    </div>

    <!-- Project 4 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/vegas.png" alt="Grand Gangster Vegas City Sim" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Grand Gangster Vegas City Sim</h3>
    </div>

    <!-- Project 5 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/scary.png" alt="Scary Girl Monster Game" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Scary Girl Monster Game</h3>
    </div>

    <!-- Project 6 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/stunts.png" alt="Build & Drive: Car Stunts" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Build & Drive: Car Stunts</h3>
    </div>
  </div>

  <!-- Explore Button -->
  <div class="mt-10 text-center">
    <a 
      href="/projects"
      class="px-6 py-3 bg-white text-black rounded-full shadow-md hover:bg-gray-200 hover:scale-105 transition-transform duration-200 no-underline"
    >
      Explore More Projects
    </a>
  </div>
</section>






</Layout>

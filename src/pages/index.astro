---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to My Portfolio">
 ---
---

<section class="relative flex flex-col-reverse md:flex-row items-center justify-center text-center md:text-left py-20 md:py-32 bg-gradient-to-b from-black via-gray-900 to-black text-white px-6 md:px-16">
  
  <!-- Left: Text content -->
  <div class="md:w-1/2 space-y-6 animate-fade-in">
    <h1 class="text-4xl md:text-6xl font-extrabold">
      Hi, I’m <span class="text-indigo-400">Izhar Ahmad</span> 👋
    </h1>

    <!-- Typewriter effect -->
    <p class="text-xl md:text-2xl font-mono text-gray-300 h-10">
      <span id="typewriter"></span>
    </p>

    <!-- Call to Action Button -->
    <div class="pt-6">
      <a href="/projects" class="px-6 py-3 text-lg font-semibold bg-indigo-500 text-white rounded-full hover:bg-indigo-600 transition">
        Explore My Work
      </a>
    </div>
  </div>

  <!-- Right: Profile Picture -->
  <div class="md:w-1/2 flex justify-center mb-8 md:mb-0">
    <img 
      src="/images/pic.png" 
      alt="Izhar Ahmad" 
      class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover border-4 border-indigo-500 shadow-2xl"
    />
  </div>
</section>

<!-- Typewriter Script -->
<script>
  const words = ["Game Developer 🎮", "Software Engineer 💻", "Unity & Multiplayer Enthusiast 🌐"];
  let i = 0;
  let j = 0;
  let currentWord = "";
  let isDeleting = false;
  const speed = 100;
  const delay = 2000;

  function type() {
    currentWord = words[i];
    document.getElementById("typewriter").textContent = currentWord.substring(0, j);

    if (!isDeleting && j < currentWord.length) {
      j++;
      setTimeout(type, speed);
    } else if (isDeleting && j > 0) {
      j--;
      setTimeout(type, speed / 2);
    } else if (!isDeleting && j === currentWord.length) {
      isDeleting = true;
      setTimeout(type, delay);
    } else if (isDeleting && j === 0) {
      isDeleting = false;
      i = (i + 1) % words.length;
      setTimeout(type, speed);
    }
  }

  type();
</script>



<section class="mt-16" w-full>
  <h2 class="text-3xl font-bold text-left mb-10">My Latest Projects</h2>

  <!-- Grid of projects -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10 max-w-7xl mx-auto">
    
    <!-- Project 1 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/poker.png" alt="Texas Hold'em 3D" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Texas Hold'em 3D – Multiplayer Poker Game</h3>
    </div>

    <!-- Project 2 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/pos.png" alt="Point of Sale System" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Point of Sale System</h3>
    </div>

    <!-- Project 3 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/speedway.png" alt="Speedway Multiplayer" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Speedway Multiplayer</h3>
    </div>

    <!-- Project 4 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/vegas.png" alt="Grand Gangster Vegas City Sim" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Grand Gangster Vegas City Sim</h3>
    </div>

    <!-- Project 5 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/scary.png" alt="Scary Girl Monster Game" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Scary Girl Monster Game</h3>
    </div>

    <!-- Project 6 -->
    <div class="w-full p-6 bg-gray-900 rounded-2xl shadow-md hover:shadow-xl transition">
      <img src="/images/stunts.png" alt="Build & Drive: Car Stunts" class="w-full h-40 object-cover rounded-xl mb-4" />
      <h3 class="text-lg font-semibold text-center">Build & Drive: Car Stunts</h3>
    </div>
  </div>

  <!-- Explore Button -->
  <div class="mt-10 text-center">
    <a 
      href="/projects"
      class="px-6 py-3 bg-white text-black rounded-full shadow-md hover:bg-gray-200 hover:scale-105 transition-transform duration-200 no-underline"
    >
      Explore More Projects
    </a>
  </div>
</section>






</Layout>

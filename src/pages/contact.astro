---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <!-- ===== Hero ===== -->
  <section class="py-12 lg:py-16 px-6 sm:px-12 text-center">
    <h1 class="text-5xl font-extrabold text-gradient mb-4">Contact Me</h1>
    <p class="text-lg text-gray-300 max-w-2xl mx-auto">
      Have a question or collaboration idea? Fill the form and your message will go straight to my inbox.
    </p>
  </section>

  <!-- ===== Contact Form Card ===== -->
  <section class="px-6 sm:px-12 pb-20">
    <div class="max-w-2xl mx-auto rounded-2xl border border-white/10 bg-gray-900/80 shadow-xl p-8 sm:p-10">
      <!-- Banners -->
      <div id="contact-success" class="hidden mb-4 rounded-lg bg-emerald-500/10 text-emerald-300 px-4 py-3 ring-1 ring-emerald-500/20">
        Thanks! Your message has been sent.
      </div>
      <div id="contact-error" class="hidden mb-4 rounded-lg bg-rose-500/10 text-rose-300 px-4 py-3 ring-1 ring-rose-500/20">
        Sorry—something went wrong. Please try again.
      </div>

      <!-- ✅ Formspree endpoint -->
      <form id="contact-form" action="https://formspree.io/f/xrblndla" method="POST" class="grid gap-6 text-left">
        <!-- Anti-spam honeypot (invisible) -->
        <input type="text" name="company" autocomplete="off" tabindex="-1" class="hidden" />

        <div>
          <label class="block text-sm text-gray-300 mb-1">Your Name</label>
          <input type="text" name="name" required
                 class="w-full rounded-xl bg-white/5 ring-1 ring-white/10 px-4 py-3 text-white 
                        placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400"
                 placeholder="John Doe" />
        </div>

        <div>
          <label class="block text-sm text-gray-300 mb-1">Email</label>
          <input type="email" name="email" required
                 class="w-full rounded-xl bg-white/5 ring-1 ring-white/10 px-4 py-3 text-white 
                        placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400"
                 placeholder="you@example.com" />
        </div>

        <div>
          <label class="block text-sm text-gray-300 mb-1">Message</label>
          <textarea name="message" rows="6" required
                    class="w-full rounded-xl bg-white/5 ring-1 ring-white/10 px-4 py-3 text-white 
                           placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400"
                    placeholder="Write your message here..."></textarea>
        </div>

        <!-- Optional: subject for your inbox -->
        <input type="hidden" name="_subject" value="New contact from website" />

        <button type="submit"
                class="inline-flex justify-center items-center gap-2 rounded-xl px-6 py-3 font-semibold text-black
                       bg-gradient-to-r from-fuchsia-400 to-cyan-300 hover:from-fuchsia-300 hover:to-cyan-200
                       transition shadow-lg shadow-fuchsia-500/20">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
          </svg>
          Send Message
        </button>
      </form>
    </div>
  </section>

  <!-- Inline JS: submit via fetch so page reload na ho -->
  <script is:inline>
    const form = document.getElementById('contact-form');
    const ok = document.getElementById('contact-success');
    const err = document.getElementById('contact-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      ok.classList.add('hidden');
      err.classList.add('hidden');

      // Honeypot block
      const hp = form.querySelector('input[name="company"]');
      if (hp && hp.value.trim() !== '') { return; }

      const fd = new FormData(form);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: fd
        });
        if (res.ok) {
          ok.classList.remove('hidden');
          form.reset();
        } else {
          const data = await res.json().catch(() => ({}));
          err.textContent = data?.error || 'Sorry—something went wrong. Please try again.';
          err.classList.remove('hidden');
        }
      } catch {
        err.classList.remove('hidden');
      }
    });
  </script>
</Layout>

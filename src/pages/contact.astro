---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <section class="py-12 lg:py-16 px-6 sm:px-12">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-gradient text-center">Contact Me</h1>
      <p class="mt-4 text-gray-300 text-center">
        Fill out the form and I’ll get back to you. You can also reach me on social if that’s easier.
      </p>

      <!-- Card -->
      <div class="mt-10 rounded-2xl border border-white/10 bg-gray-900/80 p-6 sm:p-8 shadow-xl">
        <!-- Success / Error banners -->
        <div id="contact-success" class="hidden mb-4 rounded-lg bg-emerald-500/10 text-emerald-300 px-4 py-3 ring-1 ring-emerald-500/20">
          Thanks! Your message has been sent.
        </div>
        <div id="contact-error" class="hidden mb-4 rounded-lg bg-rose-500/10 text-rose-300 px-4 py-3 ring-1 ring-rose-500/20">
          Sorry—something went wrong. Please try again.
        </div>

        <form id="contact-form" action="/api/contact" method="POST" class="grid gap-4">
          <!-- Honeypot (anti-spam) -->
          <input type="text" name="company" autocomplete="off" tabindex="-1" class="hidden" />

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm text-gray-300 mb-1">Your Name</label>
              <input name="name" required maxlength="80"
                     class="w-full rounded-xl bg-white/5 ring-1 ring-white/10 px-4 py-3 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400"
                     placeholder="John Doe" />
            </div>
            <div>
              <label class="block text-sm text-gray-300 mb-1">Email</label>
              <input type="email" name="email" required maxlength="120"
                     class="w-full rounded-xl bg-white/5 ring-1 ring-white/10 px-4 py-3 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400"
                     placeholder="you@example.com" />
            </div>
          </div>

          <div>
            <label class="block text-sm text-gray-300 mb-1">Subject</label>
            <input name="subject" required maxlength="120"
                   class="w-full rounded-xl bg-white/5 ring-1 ring-white/10 px-4 py-3 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400"
                   placeholder="Let’s work together" />
          </div>

          <div>
            <label class="block text-sm text-gray-300 mb-1">Message</label>
            <textarea name="message" required minlength="10" maxlength="4000" rows="6"
                      class="w-full rounded-xl bg-white/5 ring-1 ring-white/10 px-4 py-3 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400"
                      placeholder="Tell me a bit about your project..."></textarea>
          </div>

          <div class="flex items-center gap-2 text-sm text-gray-400">
            <input id="consent" name="consent" type="checkbox" required class="h-4 w-4 rounded border-white/20 bg-white/5" />
            <label for="consent">I consent to being contacted back about this inquiry.</label>
          </div>

          <div class="mt-2 flex flex-wrap gap-3">
            <button type="submit"
                    class="no-underline inline-flex items-center gap-2 rounded-xl px-5 py-3 font-semibold text-black
                           bg-gradient-to-r from-fuchsia-400 to-cyan-300 hover:from-fuchsia-300 hover:to-cyan-200
                           transition shadow-lg shadow-fuchsia-500/20">
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
              </svg>
              Send Message
            </button>

            <a href="mailto:youremail@example.com"
               class="no-underline inline-flex items-center gap-2 rounded-xl px-5 py-3 font-semibold text-white/90
                      bg-white/5 hover:bg-white/10 ring-1 ring-white/10 transition">
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M2 6l10 7 10-7v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/><path d="M22 6L12 13 2 6"/><path d="M2 6l10 7 10-7"/></svg>
              Email Directly
            </a>
          </div>
        </form>
      </div>

      <!-- Optional: other channels -->
      <div class="mt-8 text-center text-sm text-gray-400">
        Prefer chat? Ping me on
        <a href="https://www.youtube.com/@yourchannel" class="no-underline hover:text-white">YouTube</a>,
        <a href="https://github.com/yourprofile" class="no-underline hover:text-white">GitHub</a>,
        or <a href="https://linkedin.com/in/yourprofile" class="no-underline hover:text-white">LinkedIn</a>.
      </div>
    </div>
  </section>

  <!-- Tiny enhancement script to show success/error without leaving page -->
  <script is:inline>
    const form = document.getElementById('contact-form');
    const ok = document.getElementById('contact-success');
    const err = document.getElementById('contact-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      ok.classList.add('hidden');
      err.classList.add('hidden');
      const fd = new FormData(form);
      const res = await fetch(form.action, { method: 'POST', body: fd });
      if (res.ok) {
        ok.classList.remove('hidden');
        form.reset();
      } else {
        err.classList.remove('hidden');
      }
    });
  </script>
</Layout>

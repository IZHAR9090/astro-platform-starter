---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SDKs">
  <!-- ===== SDKs Hero & Cards (top gap fixed) ===== -->
  <section class="py-12 lg:py-16 px-6 sm:px-12 text-center">
    <h1 class="text-5xl font-extrabold text-gradient mb-10">
      Software Development Kits (SDKs)
    </h1>

    <p class="text-lg text-gray-300 max-w-3xl mx-auto mb-16">
      Here are the SDKs I have worked with and developed expertise in.  
      From game engines to mobile platforms, I have hands-on experience.
    </p>

    <!-- SDK Cards -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Unity -->
      <div class="p-6 rounded-2xl bg-gray-900 shadow-lg hover:shadow-pink-500/40 transition">
        <img src="/images/unity.svg" alt="Unity" class="h-16 w-16 mx-auto mb-4 filter invert" />
        <h3 class="text-xl font-semibold mb-2">Unity SDK</h3>
        <p class="text-gray-400 text-sm">
          Developed multiple 2D/3D games and multiplayer systems using Unity Engine.
        </p>
      </div>

      <!-- Android -->
      <div class="p-6 rounded-2xl bg-gray-900 shadow-lg hover:shadow-green-500/40 transition">
        <img src="/images/android.svg" alt="Android" class="h-16 w-16 mx-auto mb-4 filter invert" />
        <h3 class="text-xl font-semibold mb-2">Android SDK</h3>
        <p class="text-gray-400 text-sm">
          Experience in Android app development, integrations, and publishing workflows.
        </p>
      </div>

      <!-- iOS -->
      <div class="p-6 rounded-2xl bg-gray-900 shadow-lg hover:shadow-blue-500/40 transition">
        <img src="/images/xcode.svg" alt="Xcode" class="h-16 w-16 mx-auto mb-4 filter invert" />
        <h3 class="text-xl font-semibold mb-2">iOS SDK</h3>
        <p class="text-gray-400 text-sm">
          Worked with Xcode & iOS SDKs for building and deploying iPhone/iPad apps.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== AdMob SDK Download Section ===== -->
  <section class="px-6 sm:px-12 pb-16">
    <div
      class="relative overflow-hidden rounded-3xl border border-white/10
             bg-gradient-to-br from-gray-900 via-gray-900/80 to-gray-900
             shadow-xl shadow-fuchsia-500/10"
    >
      <!-- soft outer glow -->
      <div class="pointer-events-none absolute -inset-1 rounded-3xl
                  bg-gradient-to-r from-fuchsia-500/20 via-blue-500/20 to-cyan-500/20
                  blur-2xl"></div>

      <div class="relative p-8 sm:p-12 grid lg:grid-cols-[1.2fr_1fr] gap-10 items-center">
        <!-- Left: title + features -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="h-10 w-10 rounded-xl bg-white/5 flex items-center justify-center ring-1 ring-white/10">
              <svg viewBox="0 0 24 24" class="h-6 w-6 text-white/80" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="4" width="18" height="14" rx="2" />
                <path d="M7 20h10M9 8h6M6 12h4M12 12h6" />
              </svg>
            </div>
            <span class="text-xs font-semibold tracking-wider uppercase text-fuchsia-300/90">AdMob</span>
            <span class="text-xs px-2 py-1 rounded-full bg-white/10 text-white/80 ring-1 ring-white/10">SDK</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
            AdMob SDK <span class="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-400 to-cyan-300">v1.0.0</span>
          </h2>

          <p class="mt-3 text-gray-300 max-w-2xl">
            Lightweight integration for rewarded, interstitial, and banner ads. Optimized initialization,
            event hooks, and a streamlined consent flow out of the box.
          </p>

          <ul class="mt-6 grid sm:grid-cols-2 gap-3 text-sm">
            <li class="flex items-center gap-2 text-gray-300">
              <span class="h-2 w-2 rounded-full bg-fuchsia-400"></span> Unity & Android ready
            </li>
            <li class="flex items-center gap-2 text-gray-300">
              <span class="h-2 w-2 rounded-full bg-cyan-300"></span> Mediation friendly
            </li>
            <li class="flex items-center gap-2 text-gray-300">
              <span class="h-2 w-2 rounded-full bg-blue-400"></span> GDPR/UMP helpers
            </li>
            <li class="flex items-center gap-2 text-gray-300">
              <span class="h-2 w-2 rounded-full bg-violet-400"></span> Clean events API
            </li>
          </ul>
        </div>

        <!-- Right: badges + actions -->
        <div class="flex flex-col items-center lg:items-end gap-4">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-300 text-xs ring-1 ring-emerald-500/20">Stable</span>
            <span class="px-3 py-1 rounded-full bg-white/5 text-white/70 text-xs ring-1 ring-white/10">Last update: Today</span>
          </div>

          <div class="mt-2 flex flex-wrap gap-3">
            <!-- Download (underline removed) -->
            <a
              href="/downloads/admob-sdk-1.0.0.zip"
              class="no-underline inline-flex items-center gap-2 rounded-xl px-5 py-3 font-semibold text-black
                     bg-gradient-to-r from-fuchsia-400 to-cyan-300 hover:from-fuchsia-300 hover:to-cyan-200
                     transition shadow-lg shadow-fuchsia-500/20"
              download
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4" />
                <path d="M4 17v3h16v-3" />
              </svg>
              Download
            </a>

            <!-- How to Integrate? (video) – underline removed -->
            <a
              href="https://www.youtube.com/watch?v=YOUR_VIDEO_ID" target="_blank" rel="noopener"
              class="no-underline inline-flex items-center gap-2 rounded-xl px-5 py-3 font-semibold text-white/90
                     bg-white/5 hover:bg-white/10 ring-1 ring-white/10 transition"
              aria-label="How to Integrate? (opens video)"
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7-11-7z" />
              </svg>
              How to Integrate?
            </a>
          </div>

          <p class="text-xs text-gray-400 mt-2">
            SHA256: <span class="font-mono text-gray-300">b41e…9c2</span>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import Logo from '../components/Logo.astro';

// Navigation items
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Our Games', href: '/games' },
    { linkText: 'Our Studio', href: '/studio' },
    { linkText: 'Shop', href: '/shop' },
    { linkText: 'Blog', href: '/blog' },
    { linkText: 'Contact', href: '/contact' }
];

// Platform icons (SVGs or icon components)
const platformIcons = [
    { name: 'Xbox', svg: '/icons/xbox.svg', href: '#' },
    { name: 'PlayStation', svg: '/icons/playstation.svg', href: '#' },
    { name: 'Windows', svg: '/icons/windows.svg', href: '#' },
    { name: 'Steam', svg: '/icons/steam.svg', href: '#' }
];
---

<header class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-16">
    
    <!-- Left: Logo -->
    <a href="/" class="flex items-center">
      <Logo />
    </a>

    <!-- Middle: Nav Items -->
    <nav>
      <ul class="hidden md:flex space-x-6 text-sm font-medium">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class="hover:text-white transition-colors px-2 py-1"
            >
              {item.linkText}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right: Platform Icons -->
    <div class="hidden md:flex space-x-4">
      {platformIcons.map((icon) => (
        <a href={icon.href} aria-label={icon.name}>
          <img src={icon.svg} alt={icon.name} class="h-5 w-5 opacity-70 hover:opacity-100 transition" />
        </a>
      ))}
    </div>
  </div>
</header>

---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'My Projects', href: '/projects' },
    { linkText: 'My SDK', href: '/sdk' },
    { linkText: 'Contact Me', href: '/contact' }
];

const platformIcons = [
    { name: 'GitHub', svg: '/icons/github.svg', href: 'https://github.com/yourprofile' },
    { name: 'LinkedIn', svg: '/icons/linkedin.svg', href: 'https://linkedin.com/in/yourprofile' },
];
---

<header class="bg-gray-900 text-gray-300 w-full">
  <div class="flex items-center justify-between px-12 h-24 w-full">
    
    <!-- Left: Logo -->
    <a href="/" class="flex items-center">
      <Logo />
    </a>

    <!-- Middle: Nav Items -->
    <nav class="flex-1 flex justify-center">
      <ul class="flex space-x-10 text-lg font-medium">
        <li><a href="/" class="hover:text-white">Home</a></li>
        <li><a href="/projects" class="hover:text-white">My Projects</a></li>
        <li><a href="/sdk" class="hover:text-white">My SDK</a></li>
        <li><a href="/contact" class="hover:text-white">Contact Me</a></li>
      </ul>
    </nav>

    <!-- Right: Icons -->
    <div class="flex space-x-5">
      <a href="https://github.com/yourprofile">
        <img src="/icons/github.svg" alt="GitHub" class="h-6 w-6 opacity-70 hover:opacity-100" />
      </a>
      <a href="https://linkedin.com/in/yourprofile">
        <img src="/icons/linkedin.svg" alt="LinkedIn" class="h-6 w-6 opacity-70 hover:opacity-100" />
      </a>
    </div>
  </div>
</header>


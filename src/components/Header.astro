---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'My Projects', href: '/projects' },
    { linkText: 'My SDK', href: '/sdk' },
    { linkText: 'Contact Me', href: '/contact' }
];

const platformIcons = [
    { name: 'GitHub', svg: '/icons/github.svg', href: 'https://github.com/yourprofile' },
    { name: 'LinkedIn', svg: '/icons/linkedin.svg', href: 'https://linkedin.com/in/yourprofile' },
];
---

<header class="bg-gray-900 text-gray-300 w-full">
  <div class="w-full px-8 flex items-center justify-between h-24"> 
    <!-- ↑ h-24 makes it taller (96px). You can tweak: h-20, h-28 etc. -->
    
    <!-- Left: Logo -->
    <a href="/" class="flex items-center">
      <Logo />
    </a>

    <!-- Middle: Nav Items -->
    <nav class="flex-1 flex justify-center">
      <ul class="flex space-x-10 text-lg font-medium">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class="hover:text-white transition-colors px-2 py-1"
            >
              {item.linkText}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right: Icons -->
    <div class="flex space-x-5">
      {platformIcons.map((icon) => (
        <a href={icon.href} target="_blank" rel="noopener noreferrer" aria-label={icon.name}>
          <img src={icon.svg} alt={icon.name} class="h-6 w-6 opacity-70 hover:opacity-100 transition" />
        </a>
      ))}
    </div>
  </div>
</header>

<footer class="bg-gray-950 text-gray-400 mt-12 pt-12 pb-8 w-full">
  <div class="px-6 sm:px-12">
    
    <!-- Grid Layout -->
    <div class="grid md:grid-cols-3 gap-8">
      
      <!-- Brand / About -->
      <div>
        <h3 class="text-xl font-bold text-white">Izhar Ahmad</h3>
        <p class="mt-3 text-sm text-gray-400">
          Game Developer | Unity | Multiplayer Systems  
        </p>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold text-white">Quick Links</h4>
        <ul class="mt-3 space-y-2">
          <li><a href="/" class="hover:text-white transition">Home</a></li>
          <li><a href="/about" class="hover:text-white transition">About</a></li>
          <li><a href="/projects" class="hover:text-white transition">Projects</a></li>
          <li><a href="/contact" class="hover:text-white transition">Contact</a></li>
        </ul>
      </div>
      
      <!-- Social Links -->
      <div>
        <h4 class="text-lg font-semibold text-white">Connect</h4>
        <div class="mt-4 flex space-x-6">
          
          <!-- LinkedIn -->
          <a href="https://linkedin.com" target="_blank" class="hover:text-white transition">
